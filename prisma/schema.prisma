datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  SELLER
}

enum Unit {
  UN
  KG
  LT
  CX
  M
}

enum PaymentMethod {
  MONEY
  PIX
  CREDIT_CARD
  DEBIT_CARD
  ON_ACCOUNT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY // Suprimento
  WITHDRAWAL // Sangria
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  PAID
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(SELLER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sales              Sale[]
  stockMovements     StockMovement[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  receivablePayments ReceivablePayment[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String?         @unique
  barcode        String?         @unique
  costPrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal         @db.Decimal(10, 2)
  unit           Unit            @default(UN)
  currentStock   Decimal         @default(0) @db.Decimal(10, 3)
  minStock       Decimal         @default(0) @db.Decimal(10, 3)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  saleItems      SaleItem[]
  stockMovements StockMovement[]
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  document    String?      @unique
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sales       Sale[]
  receivables Receivable[]
}

model Sale {
  id             String        @id @default(cuid())
  code           Int           @default(autoincrement())
  total          Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  // Opcional: vendas anteriores ao controle de caixa não têm turno
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())
  items          SaleItem[]
  receivable     Receivable?

  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

// IN/OUT guardam quantidade positiva; ADJUSTMENT guarda o delta com sinal
// (saldo contado - saldo anterior). Todo saldo de Product muda via movimentação.
model StockMovement {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  type       MovementType
  quantity   Decimal      @db.Decimal(10, 3)
  reason     String?
  unitCost   Decimal?     @db.Decimal(10, 2)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([productId, createdAt])
}

model StoreSettings {
  id                 String   @id @default("default")
  companyName        String   // Razão Social
  tradeName          String   // Nome Fantasia
  document           String?  // CNPJ (opcional)
  stateRegistration  String?  // Inscrição Estadual (opcional)
  phone              String?  // Telefone / WhatsApp
  email              String?  // E-mail de Contato
  zipCode            String?  // CEP
  address            String?  // Logradouro (Rua, Av...)
  number             String?  // Número
  neighborhood       String?  // Bairro
  city               String?  // Cidade
  state              String?  // Estado / UF
  instagram          String?  // @usuario ou URL
  facebook           String?  // URL do Facebook
  website            String?  // URL do site
  receiptFooterNote  String?  // Mensagem no rodapé do recibo
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  document       String?         @unique
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
}

// Turno de caixa por operador. openUserId fica preenchido apenas enquanto o caixa está
// aberto: a unicidade garante no banco no máximo um caixa aberto por operador.
model CashRegister {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  openUserId         String?             @unique
  status             CashRegisterStatus  @default(OPEN)
  openingAmount      Decimal             @db.Decimal(10, 2)
  openedAt           DateTime            @default(now())
  closedAt           DateTime?
  // Snapshot gravado no fechamento (imutável depois)
  expectedAmount     Decimal?            @db.Decimal(10, 2)
  countedAmount      Decimal?            @db.Decimal(10, 2)
  difference         Decimal?            @db.Decimal(10, 2)
  closingNote        String?
  sales              Sale[]
  movements          CashMovement[]
  receivablePayments ReceivablePayment[]

  @@index([userId, openedAt])
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  reason         String
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
}

// Título a receber gerado por venda no Fiado (ON_ACCOUNT)
model Receivable {
  id         String              @id @default(cuid())
  saleId     String              @unique
  sale       Sale                @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  amount     Decimal             @db.Decimal(10, 2)
  paidAmount Decimal             @default(0) @db.Decimal(10, 2)
  status     ReceivableStatus    @default(OPEN)
  dueDate    DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  payments   ReceivablePayment[]

  @@index([customerId, status])
}

model ReceivablePayment {
  id             String        @id @default(cuid())
  receivableId   String
  receivable     Receivable    @relation(fields: [receivableId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  // Preenchido em recebimentos em dinheiro (entram na gaveta do caixa aberto)
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())
}
