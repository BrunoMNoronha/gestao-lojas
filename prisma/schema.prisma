datasource db {
  provider  = "postgresql"
  // Neon/Vercel: DATABASE_URL com pooler (app) e DIRECT_URL sem pooler (migrations).
  // Local: as duas podem apontar para o mesmo banco.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  SELLER
}

enum Unit {
  UN
  KG
  LT
  CX
  M
}

// Tipo de pessoa da loja: define os rótulos dos dados básicos e se o documento é CPF ou CNPJ
enum PersonType {
  INDIVIDUAL // Pessoa Física
  COMPANY // Pessoa Jurídica
}

enum PaymentMethod {
  MONEY
  PIX
  CREDIT_CARD
  DEBIT_CARD
  ON_ACCOUNT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY // Suprimento
  WITHDRAWAL // Sangria
}

// Tipos de operação com chave de idempotência (docs/OFFLINE.md, seção 5)
enum SyncOperationKind {
  SALE_CREATE // "sale.create" no protocolo
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  PAID
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(SELLER)
  // Usuário desativado não entra nem usa sessões já abertas (não há exclusão física)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sales              Sale[]
  stockMovements     StockMovement[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  receivablePayments ReceivablePayment[]
  syncOperations     SyncOperation[]
  registeredDevices  OfflineDevice[]     @relation("OfflineDeviceRegisteredBy")
  revokedDevices     OfflineDevice[]     @relation("OfflineDeviceRevokedBy")
  offlineGrants      OfflineGrant[]
}

// Exclusão lógica (deletedAt) e versão de sincronização (syncVersion) em Category, Product e
// Customer: issue #36, docs/OFFLINE.md seções 3.7 e 5. A unicidade de nome, SKU, código de barras e
// documento vale só entre registros ativos, por índices únicos parciais criados na migration 0007
// (o Prisma 6 não os declara e também não tenta removê-los). syncVersion é preenchida por gatilho
// no banco com o id da transação que gravou a linha; nunca é definida pela aplicação.
model Category {
  id          String    @id @default(cuid())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt    @default(0)
  products    Product[]

  @@index([syncVersion, id])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String?
  barcode        String?
  costPrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal         @db.Decimal(10, 2)
  unit           Unit            @default(UN)
  currentStock   Decimal         @default(0) @db.Decimal(10, 3)
  minStock       Decimal         @default(0) @db.Decimal(10, 3)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  // Catálogo público (/catalogo): opt-in por produto; imagem por URL externa (sem upload)
  showInCatalog  Boolean         @default(false)
  description    String?
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  syncVersion    BigInt          @default(0)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  priceHistory   ProductPrice[]

  @@index([syncVersion, id])
}

// Histórico do preço de venda (issue #36, docs/OFFLINE.md seção 3.1): uma linha por preço, gravada
// por gatilho no banco a cada cadastro ou alteração de salePrice. O preço vigente num instante é o
// da linha mais recente com validFrom <= instante. Usado na sincronização de vendas offline (#38).
model ProductPrice {
  id        BigInt   @id @default(autoincrement())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  salePrice Decimal  @db.Decimal(10, 2)
  validFrom DateTime @default(now())

  @@index([productId, validFrom])
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  document    String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt       @default(0)
  sales       Sale[]
  receivables Receivable[]

  @@index([syncVersion, id])
}

model Sale {
  id             String        @id @default(cuid())
  code           Int           @default(autoincrement())
  total          Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  // Opcional: vendas anteriores ao controle de caixa não têm turno
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  // Quando a venda aconteceu (vale para relatórios, dashboard e vencimento do Fiado) e quando o
  // servidor a recebeu. Na venda online são iguais; na offline (#38) occurredAt vem do aparelho.
  occurredAt     DateTime
  createdAt      DateTime      @default(now())
  items          SaleItem[]
  receivable     Receivable?
  syncOperation  SyncOperation?

  @@index([occurredAt])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

// IN/OUT guardam quantidade positiva; ADJUSTMENT guarda o delta com sinal
// (saldo contado - saldo anterior). Todo saldo de Product muda via movimentação.
model StockMovement {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  type       MovementType
  quantity   Decimal      @db.Decimal(10, 3)
  reason     String?
  unitCost   Decimal?     @db.Decimal(10, 2)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([productId, createdAt])
}

model StoreSettings {
  id                 String     @id @default("default")
  personType         PersonType @default(COMPANY)
  companyName        String   // Razão Social (PJ) ou Nome completo (PF)
  tradeName          String   // Nome Fantasia / Nome da loja
  document           String?  // CNPJ (PJ) ou CPF (PF), sem pontuação (opcional)
  stateRegistration  String?  // Inscrição Estadual (opcional)
  phone              String?  // Telefone / WhatsApp, só dígitos com DDD
  email              String?  // E-mail de Contato
  zipCode            String?  // CEP, só dígitos
  address            String?  // Logradouro (Rua, Av...)
  number             String?  // Número
  neighborhood       String?  // Bairro
  city               String?  // Cidade
  state              String?  // Estado / UF
  instagram          String?  // @usuario ou URL
  facebook           String?  // URL do Facebook
  website            String?  // URL do site
  receiptFooterNote  String?  // Mensagem no rodapé do recibo
  whatsappNumber     String?  // WhatsApp do catálogo, só dígitos com DDI (ex.: 5511999998888)
  catalogEnabled     Boolean  @default(false) // Catálogo público (/catalogo) ativo
  // Venda no Fiado (issue #29): os padrões mantêm o comportamento anterior (permitido, sem regras)
  onAccountEnabled      Boolean  @default(true)  // Desligado: o PDV e o servidor recusam o Fiado
  onAccountDueDays      Int?     // Prazo do título em dias corridos; nulo = sem vencimento
  onAccountCreditLimit  Decimal? @db.Decimal(10, 2) // Saldo em aberto + venda, por cliente; nulo = sem limite
  onAccountBlockOverdue Boolean  @default(false) // Bloqueia o Fiado de cliente com título vencido
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  document       String?         @unique
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
}

// Turno de caixa por operador. openUserId fica preenchido apenas enquanto o caixa está
// aberto: a unicidade garante no banco no máximo um caixa aberto por operador.
model CashRegister {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  openUserId         String?             @unique
  status             CashRegisterStatus  @default(OPEN)
  openingAmount      Decimal             @db.Decimal(10, 2)
  openedAt           DateTime            @default(now())
  closedAt           DateTime?
  // Snapshot gravado no fechamento (imutável depois)
  expectedAmount     Decimal?            @db.Decimal(10, 2)
  countedAmount      Decimal?            @db.Decimal(10, 2)
  difference         Decimal?            @db.Decimal(10, 2)
  closingNote        String?
  sales              Sale[]
  movements          CashMovement[]
  receivablePayments ReceivablePayment[]
  syncOperations     SyncOperation[]
  offlineGrants      OfflineGrant[]

  @@index([userId, openedAt])
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  reason         String
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
}

// Título a receber gerado por venda no Fiado (ON_ACCOUNT)
model Receivable {
  id         String              @id @default(cuid())
  saleId     String              @unique
  sale       Sale                @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  amount     Decimal             @db.Decimal(10, 2)
  paidAmount Decimal             @default(0) @db.Decimal(10, 2)
  status     ReceivableStatus    @default(OPEN)
  dueDate    DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  payments   ReceivablePayment[]

  @@index([customerId, status])
}

model ReceivablePayment {
  id             String        @id @default(cuid())
  receivableId   String
  receivable     Receivable    @relation(fields: [receivableId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  // Preenchido em recebimentos em dinheiro (entram na gaveta do caixa aberto)
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())
}

// Chave de idempotência das operações (issue #35, docs/OFFLINE.md seção 5). A linha é gravada na
// mesma transação dos efeitos: rollback não deixa registro, e a mesma chave nunca produz dois
// conjuntos de efeitos. Mesma chave com payload diferente (outro hash) é recusada.
model SyncOperation {
  id             String            @id @db.Uuid // operationId gerado no PDV / aparelho
  kind           SyncOperationKind
  payloadHash    String // SHA-256 (hex) do payload canônico
  userId         String // Operador original
  user           User              @relation(fields: [userId], references: [id])
  deviceId       String? // Aparelho registrado (#37); nulo no PDV online
  cashRegisterId String? // Caixa original
  cashRegister   CashRegister?     @relation(fields: [cashRegisterId], references: [id])
  saleId         String?           @unique
  sale           Sale?             @relation(fields: [saleId], references: [id])
  occurredAt     DateTime // Instante da operação no aparelho
  receivedAt     DateTime          @default(now()) // Instante de recebimento no servidor

  @@index([userId, receivedAt])
}

// Aparelho habilitado para o PDV offline (issue #37, docs/OFFLINE.md seção 7). Registrado na
// primeira preparação e reaproveitado pelos operadores que preparam o mesmo navegador. Aparelho
// revogado não recebe nova autorização offline.
model OfflineDevice {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  registeredById String
  registeredBy   User           @relation("OfflineDeviceRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime       @default(now())
  lastSyncAt     DateTime? // Última preparação ou renovação neste aparelho
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?          @relation("OfflineDeviceRevokedBy", fields: [revokedById], references: [id])
  grants         OfflineGrant[]
}

// Autorização offline (docs/OFFLINE.md seção 3.5): emitida na preparação online, vale para um
// operador, um aparelho e o caixa aberto dele, por no máximo 12 horas. Os instantes são do
// servidor; o aparelho só os usa para avisar e bloquear localmente.
model OfflineGrant {
  id             String        @id @default(uuid()) @db.Uuid
  deviceId       String        @db.Uuid
  device         OfflineDevice @relation(fields: [deviceId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  issuedAt       DateTime      @default(now())
  expiresAt      DateTime

  @@index([deviceId, userId, issuedAt])
}
