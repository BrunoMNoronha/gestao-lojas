datasource db {
  provider  = "postgresql"
  // Neon/Vercel: DATABASE_URL com pooler (app) e DIRECT_URL sem pooler (migrations).
  // Local: as duas podem apontar para o mesmo banco.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  SELLER
}

enum Unit {
  UN
  KG
  LT
  CX
  M
}

// Tipo de pessoa da loja: define os rótulos dos dados básicos e se o documento é CPF ou CNPJ
enum PersonType {
  INDIVIDUAL // Pessoa Física
  COMPANY // Pessoa Jurídica
}

enum PaymentMethod {
  MONEY
  PIX
  CREDIT_CARD
  DEBIT_CARD
  ON_ACCOUNT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY // Suprimento
  WITHDRAWAL // Sangria
}

// Tipos de operação com chave de idempotência (docs/OFFLINE.md, seção 5)
enum SyncOperationKind {
  SALE_CREATE // "sale.create" no protocolo
}

// Situação da operação no servidor (docs/OFFLINE.md, seção 4). A venda online grava APPLIED.
enum SyncOperationStatus {
  APPLIED // Efeitos gravados na sincronização
  CONFLICT // Recusada por regra de negócio, sem efeito; aguarda decisão de um gerente
  APPROVED // Conflito aprovado: efeitos gravados com a autoria e o caixa originais
  DISCARDED // Conflito descartado com motivo, sem efeito
}

// Motivo de uma operação offline não ter sido aplicada (docs/OFFLINE.md, seção 4)
enum SyncConflictReason {
  DEVICE_REVOKED // Aparelho revogado
  GRANT_MISMATCH // Autorização offline inexistente ou de outro operador, aparelho ou caixa
  CASH_REGISTER_MISMATCH // Caixa original inexistente ou de outro operador
  PRICE_NOT_VALID // Preço praticado que não vigorou no período da autorização
  PRODUCT_NOT_FOUND // Produto que nunca existiu
  CUSTOMER_NOT_FOUND // Cliente que nunca existiu
  FRACTIONAL_QUANTITY // Quantidade fracionada em produto vendido por unidade inteira
  ON_ACCOUNT_OFFLINE // Fiado não é permitido offline
  INVALID_AMOUNTS // Desconto maior que o subtotal ou valor pago menor que o total
  ASSISTED_SUBMISSION // Enviada por um gerente em nome do operador original (sem outro conflito)
}

// Pendência de conciliação: a venda foi aplicada, mas exige acompanhamento (docs/OFFLINE.md, seção 4)
enum ReconciliationIssueType {
  NEGATIVE_STOCK // A baixa deixou o saldo do produto negativo
  POST_CLOSING_SALE // A venda chegou depois do fechamento do caixa original
  PRICE_DIVERGENCE // Preço praticado diferente do preço atual
  DATE_ADJUSTED // Data informada pelo aparelho fora do intervalo permitido
  DELETED_CUSTOMER // Cliente excluído depois da venda offline
}

// Execuções da seção "Dados de teste" em Configurações (issue #57)
enum TestDataRunKind {
  GENERATE // Gerar dados de teste
  RESET // Restaurar o banco (mantém usuários e configurações da loja)
}

enum TestDataRunStatus {
  COMPLETED // Efeitos gravados
  REJECTED // Recusada (confirmação errada, impedimento ou limite), sem efeito
  FAILED // Erro inesperado; a transação foi desfeita
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  PAID
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(SELLER)
  // Usuário desativado não entra nem usa sessões já abertas (não há exclusão física)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sales              Sale[]
  stockMovements     StockMovement[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  receivablePayments ReceivablePayment[]
  syncOperations     SyncOperation[]     @relation("SyncOperationAuthor")
  resolvedOperations SyncOperation[]     @relation("SyncOperationResolver")
  submittedOperations SyncOperation[]    @relation("SyncOperationSubmitter")
  registeredDevices  OfflineDevice[]     @relation("OfflineDeviceRegisteredBy")
  revokedDevices     OfflineDevice[]     @relation("OfflineDeviceRevokedBy")
  offlineGrants      OfflineGrant[]
  acknowledgedIssues ReconciliationIssue[]
  testDataRuns       TestDataRun[]
}

// Exclusão lógica (deletedAt) e versão de sincronização (syncVersion) em Category, Product e
// Customer: issue #36, docs/OFFLINE.md seções 3.7 e 5. A unicidade de nome, SKU, código de barras e
// documento vale só entre registros ativos, por índices únicos parciais criados na migration 0007
// (o Prisma 6 não os declara e também não tenta removê-los). syncVersion é preenchida por gatilho
// no banco com o id da transação que gravou a linha; nunca é definida pela aplicação.
model Category {
  id          String    @id @default(cuid())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt    @default(0)
  products    Product[]

  @@index([syncVersion, id])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String?
  barcode        String?
  costPrice      Decimal         @db.Decimal(10, 2)
  salePrice      Decimal         @db.Decimal(10, 2)
  unit           Unit            @default(UN)
  currentStock   Decimal         @default(0) @db.Decimal(10, 3)
  minStock       Decimal         @default(0) @db.Decimal(10, 3)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  // Catálogo público (/catalogo): opt-in por produto; imagem por URL externa (sem upload)
  showInCatalog  Boolean         @default(false)
  description    String?
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  syncVersion    BigInt          @default(0)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  priceHistory   ProductPrice[]
  reconciliationIssues ReconciliationIssue[]

  @@index([syncVersion, id])
}

// Histórico do preço de venda (issue #36, docs/OFFLINE.md seção 3.1): uma linha por preço, gravada
// por gatilho no banco a cada cadastro ou alteração de salePrice. O preço vigente num instante é o
// da linha mais recente com validFrom <= instante. Usado na sincronização de vendas offline (#38).
model ProductPrice {
  id        BigInt   @id @default(autoincrement())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  salePrice Decimal  @db.Decimal(10, 2)
  validFrom DateTime @default(now())

  @@index([productId, validFrom])
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  document    String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt       @default(0)
  sales       Sale[]
  receivables Receivable[]

  @@index([syncVersion, id])
}

model Sale {
  id             String        @id @default(cuid())
  code           Int           @default(autoincrement())
  total          Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  // Opcional: vendas anteriores ao controle de caixa não têm turno
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  // Quando a venda aconteceu (vale para relatórios, dashboard e vencimento do Fiado) e quando o
  // servidor a recebeu. Na venda online são iguais; na offline (#38) occurredAt vem do aparelho.
  occurredAt     DateTime
  createdAt      DateTime      @default(now())
  items          SaleItem[]
  receivable     Receivable?
  syncOperation  SyncOperation?
  reconciliationIssues ReconciliationIssue[]

  @@index([occurredAt])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

// IN/OUT guardam quantidade positiva; ADJUSTMENT guarda o delta com sinal
// (saldo contado - saldo anterior). Todo saldo de Product muda via movimentação.
model StockMovement {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  type       MovementType
  quantity   Decimal      @db.Decimal(10, 3)
  reason     String?
  unitCost   Decimal?     @db.Decimal(10, 2)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([productId, createdAt])
}

model StoreSettings {
  id                 String     @id @default("default")
  personType         PersonType @default(COMPANY)
  companyName        String   // Razão Social (PJ) ou Nome completo (PF)
  tradeName          String   // Nome Fantasia / Nome da loja
  document           String?  // CNPJ (PJ) ou CPF (PF), sem pontuação (opcional)
  stateRegistration  String?  // Inscrição Estadual (opcional)
  phone              String?  // Telefone / WhatsApp, só dígitos com DDD
  email              String?  // E-mail de Contato
  zipCode            String?  // CEP, só dígitos
  address            String?  // Logradouro (Rua, Av...)
  number             String?  // Número
  neighborhood       String?  // Bairro
  city               String?  // Cidade
  state              String?  // Estado / UF
  instagram          String?  // @usuario ou URL
  facebook           String?  // URL do Facebook
  website            String?  // URL do site
  receiptFooterNote  String?  // Mensagem no rodapé do recibo
  whatsappNumber     String?  // WhatsApp do catálogo, só dígitos com DDI (ex.: 5511999998888)
  catalogEnabled     Boolean  @default(false) // Catálogo público (/catalogo) ativo
  // Venda no Fiado (issue #29): os padrões mantêm o comportamento anterior (permitido, sem regras)
  onAccountEnabled      Boolean  @default(true)  // Desligado: o PDV e o servidor recusam o Fiado
  onAccountDueDays      Int?     // Prazo do título em dias corridos; nulo = sem vencimento
  onAccountCreditLimit  Decimal? @db.Decimal(10, 2) // Saldo em aberto + venda, por cliente; nulo = sem limite
  onAccountBlockOverdue Boolean  @default(false) // Bloqueia o Fiado de cliente com título vencido
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  document       String?         @unique
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
}

// Turno de caixa por operador. openUserId fica preenchido apenas enquanto o caixa está
// aberto: a unicidade garante no banco no máximo um caixa aberto por operador.
model CashRegister {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  openUserId         String?             @unique
  status             CashRegisterStatus  @default(OPEN)
  openingAmount      Decimal             @db.Decimal(10, 2)
  openedAt           DateTime            @default(now())
  closedAt           DateTime?
  // Snapshot gravado no fechamento (imutável depois)
  expectedAmount     Decimal?            @db.Decimal(10, 2)
  countedAmount      Decimal?            @db.Decimal(10, 2)
  difference         Decimal?            @db.Decimal(10, 2)
  closingNote        String?
  sales              Sale[]
  movements          CashMovement[]
  receivablePayments ReceivablePayment[]
  syncOperations     SyncOperation[]
  offlineGrants      OfflineGrant[]

  @@index([userId, openedAt])
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  reason         String
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
}

// Título a receber gerado por venda no Fiado (ON_ACCOUNT)
model Receivable {
  id         String              @id @default(cuid())
  saleId     String              @unique
  sale       Sale                @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  amount     Decimal             @db.Decimal(10, 2)
  paidAmount Decimal             @default(0) @db.Decimal(10, 2)
  status     ReceivableStatus    @default(OPEN)
  dueDate    DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  payments   ReceivablePayment[]

  @@index([customerId, status])
}

model ReceivablePayment {
  id             String        @id @default(cuid())
  receivableId   String
  receivable     Receivable    @relation(fields: [receivableId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  // Preenchido em recebimentos em dinheiro (entram na gaveta do caixa aberto)
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())
}

// Chave de idempotência das operações (issue #35, docs/OFFLINE.md seção 5). A linha é gravada na
// mesma transação dos efeitos: rollback não deixa registro, e a mesma chave nunca produz dois
// conjuntos de efeitos. Mesma chave com payload diferente (outro hash) é recusada.
// Operação offline (#38): o payload fica guardado para a conciliação, e um conflito é gravado com
// a situação CONFLICT e nenhum efeito.
model SyncOperation {
  id              String               @id @db.Uuid // operationId gerado no PDV / aparelho
  kind            SyncOperationKind
  status          SyncOperationStatus  @default(APPLIED)
  payloadHash     String // SHA-256 (hex) do payload canônico
  // Operação offline normalizada (envelope e venda), usada para aprovar um conflito; nulo no online
  payload         Json?
  userId          String // Operador original
  user            User                 @relation("SyncOperationAuthor", fields: [userId], references: [id])
  deviceId        String?              @db.Uuid // Aparelho registrado (#37); nulo no PDV online
  device          OfflineDevice?       @relation(fields: [deviceId], references: [id])
  grantId         String?              @db.Uuid // Autorização offline usada; nulo no online
  grant           OfflineGrant?        @relation(fields: [grantId], references: [id])
  cashRegisterId  String? // Caixa original
  cashRegister    CashRegister?        @relation(fields: [cashRegisterId], references: [id])
  saleId          String?              @unique
  sale            Sale?                @relation(fields: [saleId], references: [id])
  occurredAt      DateTime // Instante da operação no aparelho (como enviado)
  receivedAt      DateTime             @default(now()) // Instante de recebimento no servidor
  // Id da transação que gravou os efeitos (pg_current_xact_id): o aparelho compara com o limite da
  // cópia local para saber quando a baixa de estoque já chegou nela
  appliedTxid     BigInt?
  conflictReason  SyncConflictReason?
  conflictMessage String?
  resolvedById    String?
  resolvedBy      User?                @relation("SyncOperationResolver", fields: [resolvedById], references: [id])
  // Gerente que enviou a operação em nome do operador original (envio assistido, #38); nulo no
  // envio pelo próprio operador
  submittedById   String?
  submittedBy     User?                @relation("SyncOperationSubmitter", fields: [submittedById], references: [id])
  resolvedAt      DateTime?
  resolutionNote  String?

  @@index([userId, receivedAt])
  @@index([status, receivedAt])
}

// Pendência de conciliação de uma venda offline já aplicada (issue #38, docs/OFFLINE.md seção 4):
// estoque negativo, venda pós-fechamento, preço divergente, data ajustada ou cliente excluído.
// Quem tem offline.reconcile registra a ciência; nada aqui desfaz a venda.
model ReconciliationIssue {
  id               String                  @id @default(cuid())
  type             ReconciliationIssueType
  saleId           String
  sale             Sale                    @relation(fields: [saleId], references: [id])
  productId        String?
  product          Product?                @relation(fields: [productId], references: [id])
  // Valores do caso (ex.: preço praticado e atual, data original e ajustada, saldo resultante)
  details          Json
  createdAt        DateTime                @default(now())
  acknowledgedById String?
  acknowledgedBy   User?                   @relation(fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?
  note             String?

  @@index([acknowledgedAt, createdAt])
  @@index([saleId])
}

// Aparelho habilitado para o PDV offline (issue #37, docs/OFFLINE.md seção 7). Registrado na
// primeira preparação e reaproveitado pelos operadores que preparam o mesmo navegador. Aparelho
// revogado não recebe nova autorização offline.
model OfflineDevice {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  registeredById String
  registeredBy   User           @relation("OfflineDeviceRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime       @default(now())
  lastSyncAt     DateTime? // Última preparação ou renovação neste aparelho
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?          @relation("OfflineDeviceRevokedBy", fields: [revokedById], references: [id])
  grants         OfflineGrant[]
  operations     SyncOperation[]
}

// Autorização offline (docs/OFFLINE.md seção 3.5): emitida na preparação online, vale para um
// operador, um aparelho e o caixa aberto dele, por no máximo 12 horas. Os instantes são do
// servidor; o aparelho só os usa para avisar e bloquear localmente.
model OfflineGrant {
  id             String        @id @default(uuid()) @db.Uuid
  deviceId       String        @db.Uuid
  device         OfflineDevice @relation(fields: [deviceId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  issuedAt       DateTime      @default(now())
  expiresAt      DateTime
  // Vendas desta autorização ainda não gravadas no servidor, informadas pelo aparelho (#38): o
  // fechamento do caixa avisa quando algum aparelho ainda tem vendas dele
  pendingCount      Int?
  pendingReportedAt DateTime?
  operations     SyncOperation[]

  @@index([deviceId, userId, issuedAt])
  @@index([cashRegisterId])
}

// Histórico da seção "Dados de teste" em Configurações (issue #57): cada geração de dados de teste
// e cada restauração do banco, inclusive as recusadas. O id é o do pedido gerado no navegador: a
// mesma geração repetida (clique duplo, resposta perdida) devolve o resultado já gravado. A
// restauração nunca apaga esta tabela, e o último RESET concluído marca a época dos dados usada no
// cursor da cópia local do PDV.
model TestDataRun {
  id        String            @id @db.Uuid
  kind      TestDataRunKind
  status    TestDataRunStatus
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  params    Json? // Quantidades pedidas na geração
  counts    Json? // Registros criados (GENERATE) ou apagados por tabela (RESET)
  message   String? // Motivo da recusa ou da falha
  createdAt DateTime          @default(now())

  @@index([kind, status, createdAt])
  @@index([userId, createdAt])
}
