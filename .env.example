# Copie para `.env` (desenvolvimento). Nunca versione valores reais.

# ── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# DATABASE_URL: conexão usada pela aplicação (na Neon/Vercel, a URL com pooler).
# DIRECT_URL:   conexão direta usada pelas migrations (na Neon, a URL "unpooled").
# Localmente as duas podem apontar para o mesmo banco.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_lojas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestao_lojas?schema=public"

# ── Autenticação (Auth.js v5) ────────────────────────────────────────────────
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
# NEXTAUTH_SECRET ainda é aceito como alias, mas o padrão do projeto é AUTH_SECRET.
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Opcional. Na Vercel o host é detectado automaticamente. Para `pnpm start` local,
# defina AUTH_URL="http://localhost:3000" ou AUTH_TRUST_HOST=true.
# AUTH_URL="http://localhost:3000"

# ── Primeiro administrador ───────────────────────────────────────────────────
# Usado somente quando o banco ainda não tem nenhum usuário (no primeiro login).
# Produção: obrigatórios, senha com no mínimo 12 caracteres.
# Desenvolvimento: se omitidos, é criado o admin local admin@gestaolojas.com / admin123.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── reCAPTCHA v3 na tela de login ────────────────────────────────────────────
# Chaves de um projeto do Google Cloud (passo a passo em docs/DEPLOY.md).
# Desenvolvimento: opcionais. Sem RECAPTCHA_SECRET_KEY a verificação fica desligada (aviso no log).
# Produção: obrigatórias. Sem RECAPTCHA_SECRET_KEY o login é recusado (fail closed).
# RECAPTCHA_SITE_KEY é a chave do site (pública, vai para a tela de login); mudou, redeploy.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Opcionais: score mínimo (0 a 1, padrão 0.5) e hosts aceitos, separados por vírgula
# (padrão: o host da própria requisição de login).
# RECAPTCHA_MIN_SCORE="0.5"
# RECAPTCHA_ALLOWED_HOSTNAMES="gestao-lojas-dpv.vercel.app"

# ── Dados de teste (Configurações → "Dados de teste") ────────────────────────
# Gerar, remover os gerados e restaurar o banco só funcionam com "true" (issue #67).
# Desligado por padrão. NUNCA ligue em produção: a restauração apaga vendas, caixa e estoque.
# ENABLE_STORE_TEST_TOOLS="true"
